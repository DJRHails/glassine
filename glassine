#!/usr/bin/env bash
#
# glassine — transparent sops-backed encryption for git
#
# Glassine is the translucent archival paper used to protect valuable
# documents. This tool keeps sops envelopes in your git history while your
# working tree holds plaintext: opaque to the remote, transparent to anyone
# holding a key.
#
# https://github.com/DJRHails/glassine
set -euo pipefail

readonly VERSION='0.7.1'

GLASSINE_TMPDIR=''

die() {
  printf 'glassine: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'glassine: %s\n' "$*" >&2
}

# Hard requirement on sops, with an actionable install hint. Deliberately
# never auto-installs: pulling a crypto engine onto the machine is the
# user's call, via their own package manager.
need_sops() {
  command -v sops >/dev/null 2>&1 && return 0
  local hint='https://github.com/getsops/sops/releases'
  if command -v brew >/dev/null 2>&1; then
    hint='brew install sops'
  elif command -v apt-get >/dev/null 2>&1; then
    hint='apt-get install sops (or grab a release: https://github.com/getsops/sops/releases)'
  elif command -v pacman >/dev/null 2>&1; then
    hint='pacman -S sops'
  elif command -v nix-env >/dev/null 2>&1; then
    hint='nix-env -iA nixpkgs.sops'
  fi
  die "sops is required but not installed — try: $hint"
}

ensure_tmpdir() {
  if [ -z "$GLASSINE_TMPDIR" ]; then
    GLASSINE_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/glassine.XXXXXX")
    trap 'rm -rf -- "${GLASSINE_TMPDIR:?}"' EXIT
  fi
}

# A sops envelope always carries a MAC over its contents in its metadata,
# regardless of input type:
#   YAML:   mac: ENC[AES256_GCM,...      JSON: "mac": "ENC[AES256_GCM,...
#   dotenv: sops_mac=ENC[AES256_GCM,...  ini:  mac = ENC[AES256_GCM,...
# Matching on that is key-independent, so keyless hosts can recognise
# ciphertext too. (-a treats binary content as text.)
is_envelope() {
  LC_ALL=C grep -aqE 'mac[^[:alnum:]]{1,4}ENC\[AES256_GCM' "$1"
}

# True when <file> looks binary by git's own heuristic — a NUL byte in the
# first 8000 bytes. Binary content DOES survive glassine (sops base64-wraps it
# and clean's memoisation keeps it stable), but an encrypted binary is an opaque
# blob: `diff=glassine` can't show a meaningful change, review sees nothing, and
# it's the classic footgun that silently breaks *other* crypt filters on PNGs.
# So callers advise rather than encrypt binaries blindly. Pure NUL test, no
# extra deps: strip NULs from the sample and see if anything changed.
is_binary() { # <file>
  ensure_tmpdir
  local sample="$GLASSINE_TMPDIR/bin_sample" stripped="$GLASSINE_TMPDIR/bin_stripped"
  LC_ALL=C head -c 8000 -- "$1" >"$sample" 2>/dev/null || return 1
  LC_ALL=C tr -d '\000' <"$sample" >"$stripped"
  ! cmp -s "$sample" "$stripped"
}

# Decrypt src into dst, presenting the repo-relative path to sops so that
# input-type detection and .sops.yaml creation rules behave as if the file
# were at its real location.
#
# sops itself only probes ~/.ssh/id_ed25519 and ~/.ssh/id_rsa, so per-service
# key names (id_github, id_work, …) would otherwise behave keyless. When the
# default identities fail, scan ~/.ssh for key pairs whose public half is
# among the envelope's own recipients — the metadata is plaintext, so the
# match costs a grep and only matching keys are ever tried. The first key
# that decrypts is pinned as `git config glassine.identity`, which
# maybe_export_identity turns into the fast path for every later call.
decrypt_to() { # <src> <dst> <repo-relative-path>
  if sops decrypt --filename-override "$3" "$1" >"$2" 2>/dev/null; then
    return 0
  fi
  local pub key material
  for pub in "$HOME"/.ssh/*.pub; do
    key=${pub%.pub}
    [ -f "$pub" ] || continue
    [ -f "$key" ] || continue
    material=$(cut -d' ' -f2 "$pub" 2>/dev/null || true)
    [ -n "$material" ] || continue
    LC_ALL=C grep -aqF "$material" "$1" || continue # not a recipient of this envelope
    if SOPS_AGE_SSH_PRIVATE_KEY_FILE=$key sops decrypt --filename-override "$3" "$1" >"$2" 2>/dev/null </dev/null; then
      if [ -z "$(git config glassine.identity 2>/dev/null || true)" ] &&
        git config glassine.identity "$key" 2>/dev/null; then
        warn "decrypted with $key — pinned via git config glassine.identity"
      fi
      return 0
    fi
  done
  return 1
}

# sops only probes ~/.ssh/id_ed25519 and ~/.ssh/id_rsa for SSH identities, so
# a key at any other path (common: per-service names like ~/.ssh/id_github)
# silently fails to decrypt. `git config glassine.identity <path>` names the
# key per repository+machine (--type=path applies git's own ~ expansion); an
# explicit SOPS_AGE_SSH_PRIVATE_KEY_FILE in the environment always wins.
maybe_export_identity() {
  [ -z "${SOPS_AGE_SSH_PRIVATE_KEY_FILE:-}" ] || return 0
  local raw id
  raw=$(git config glassine.identity 2>/dev/null) || return 0
  if ! id=$(git config --type=path glassine.identity 2>/dev/null) || [ ! -f "$id" ]; then
    warn "glassine.identity does not resolve to a key file: $raw"
    return 0
  fi
  export SOPS_AGE_SSH_PRIVATE_KEY_FILE=$id
}

# True when some decryption identity is plausibly available: an explicit env
# var (maybe_export_identity has already turned glassine.identity into one —
# main runs it before dispatching any command), a default SSH key, an age
# keys.txt in either the macOS or XDG location, or any SSH key pair in ~/.ssh
# (decrypt_to scans those against each envelope's recipients).
has_identity() {
  [ -n "${SOPS_AGE_SSH_PRIVATE_KEY_FILE:-}" ] && return 0
  [ -n "${SOPS_AGE_KEY:-}${SOPS_AGE_KEY_FILE:-}${SOPS_AGE_KEY_CMD:-}" ] && return 0
  [ -f "$HOME/.ssh/id_ed25519" ] || [ -f "$HOME/.ssh/id_rsa" ] && return 0
  [ -f "$HOME/Library/Application Support/sops/age/keys.txt" ] && return 0
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt" ] && return 0
  local pub
  for pub in "$HOME"/.ssh/*.pub; do
    if [ -f "$pub" ] && [ -f "${pub%.pub}" ]; then
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# git filter hooks
# ---------------------------------------------------------------------------

# clean: plaintext from stdin -> envelope on stdout (worktree -> repository).
#
# sops output is randomised (fresh data key, IVs, lastmodified, MAC), but git
# requires clean to be a pure function or every `git status` dirties the
# file. We restore purity by memoising against the index: when the staged
# envelope decrypts to exactly the incoming plaintext, re-emit it unchanged.
cmd_clean() { # <repo-relative-path>
  local path=$1
  need_sops
  ensure_tmpdir
  local work="$GLASSINE_TMPDIR/work"
  cat >"$work"

  # sops refuses empty input ("must contain at least one document"); there is
  # nothing to protect anyway, so empty files pass through (as in transcrypt).
  if [ ! -s "$work" ]; then
    return
  fi

  # Already-encrypted content round-trips untouched, so keyless checkouts
  # can never corrupt (or double-encrypt) an envelope. Forced rotation is the
  # exception: when this host can decrypt the envelope, re-mint it under the
  # current .sops.yaml; when it can't, pass it through and say so — rotate
  # turns that miss into a report instead of a false success.
  if is_envelope "$work"; then
    local reminted="$GLASSINE_TMPDIR/reminted"
    if [ "${GLASSINE_FORCE:-0}" = '1' ] && decrypt_to "$work" "$reminted" "$path"; then
      cat "$reminted" >"$work"
    else
      if [ "${GLASSINE_FORCE:-0}" = '1' ]; then
        warn "cannot rotate '$path': no decryption key on this host"
      fi
      cat "$work"
      return
    fi
  fi

  if [ "${GLASSINE_FORCE:-0}" != '1' ]; then
    local staged="$GLASSINE_TMPDIR/staged" staged_plain="$GLASSINE_TMPDIR/staged_plain"
    if git cat-file blob ":$path" >"$staged" 2>/dev/null && is_envelope "$staged"; then
      if decrypt_to "$staged" "$staged_plain" "$path" && cmp -s "$staged_plain" "$work"; then
        cat "$staged"
        return
      fi
    fi
  fi

  # Real change (or forced rotation): fresh envelope, fresh data key.
  sops encrypt --filename-override "$path" "$work" ||
    die "encryption failed for '$path' — do .sops.yaml creation_rules cover this path?"
}

# smudge: envelope from stdin -> plaintext on stdout (repository -> worktree).
# Never fails: hosts without a matching identity get the envelope verbatim,
# which clean passes back through unchanged.
cmd_smudge() { # <repo-relative-path>
  local path=$1
  ensure_tmpdir
  local work="$GLASSINE_TMPDIR/work" plain="$GLASSINE_TMPDIR/plain"
  cat >"$work"
  if command -v sops >/dev/null 2>&1 && decrypt_to "$work" "$plain" "$path"; then
    cat "$plain"
  else
    cat "$work"
  fi
}

# textconv: decrypt a blob for diff display. git hands us a bare temporary
# file with the original extension lost, so probe likely input types.
cmd_textconv() { # <file>
  local file=$1 t
  if command -v sops >/dev/null 2>&1; then
    for t in json yaml dotenv ini binary; do
      if sops decrypt --input-type "$t" --output-type "$t" "$file" 2>/dev/null; then
        return
      fi
    done
  fi
  cat "$file"
}

# merge: three-way merge in plaintext space. git stores %A's bytes verbatim
# as the resolution (clean is NOT applied), so on success we must re-encrypt;
# on conflict we leave plaintext with markers — the user resolves in the
# working tree and their `git add` re-encrypts.
cmd_merge() { # <base %O> <ours %A> <theirs %B> <marker-size %L> <path %P>
  [ $# -eq 5 ] || die 'usage (git-internal): glassine merge %O %A %B %L %P'
  local base=$1 ours=$2 theirs=$3 marker=$4 path=$5
  need_sops
  ensure_tmpdir

  local f plain="$GLASSINE_TMPDIR/merge_plain"
  for f in "$base" "$ours" "$theirs"; do
    if [ -s "$f" ] && is_envelope "$f"; then
      if decrypt_to "$f" "$plain" "$path"; then
        cat "$plain" >"$f"
      else
        warn "cannot decrypt $path on this host — merging at ciphertext level"
      fi
    fi
  done

  if git merge-file --marker-size="$marker" -L ours -L base -L theirs \
    "$ours" "$base" "$theirs" >/dev/null 2>&1; then
    sops encrypt --filename-override "$path" "$ours" >"$GLASSINE_TMPDIR/merge_enc" ||
      die "re-encryption after merge failed for '$path'"
    cat "$GLASSINE_TMPDIR/merge_enc" >"$ours"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# repository commands
# ---------------------------------------------------------------------------

# Tracked paths whose filter attribute is glassine, NUL-separated on stdout,
# optionally restricted to the given pathspecs.
# Regular files only: git never runs filters on symlinks or submodules (their
# blobs hold the target/commit raw), so glassine cannot manage them and every
# command that judged them anyway raised false alarms (rotate: phantom drift,
# check: NOT ENCRYPTED, status: PLAINTEXT).
managed_files() { # [pathspec...]
  local entry
  git ls-files -sz -- "$@" |
    while IFS= read -r -d '' entry; do
      case "$entry" in
      100*) printf '%s\0' "${entry#*$'\t'}" ;;
      esac
    done |
    git check-attr --stdin -z filter |
    while IFS= read -r -d '' p && IFS= read -r -d '' _ && IFS= read -r -d '' v; do
      if [ "$v" = 'glassine' ]; then
        printf '%s\0' "$p"
      fi
    done
}

# ---------------------------------------------------------------------------
# recipient management (.sops.yaml)
#
# WHICH files are protected is decided solely by .gitattributes (glassine
# protect); .sops.yaml answers WHO may read them. The managed layout holds
# scoped rules first (one per `allow --path` glob, identified by the
# `# glob:` comment on its path_regex line) and the repo-wide catch-all
# last — sops takes the first matching rule, so a scoped rule's recipient
# set is exactly who can read its files. Scoped rules are seeded with the
# catch-all's recipients and every global allow propagates into them, so
# scoped grants only ever widen access. Auto-editing is gated on the
# "managed by glassine" marker — hand-written files are never rewritten.
# ---------------------------------------------------------------------------

sops_yaml_managed() { # <file>
  head -1 "$1" 2>/dev/null | grep -q 'managed by glassine'
}

# Translate a protect-style glob into the anchored regex sops matches against
# the path (relative to .sops.yaml — glassine always runs sops at the repo
# root): ** crosses directories, * and ? stay within one component.
glob_to_regex() { # <glob>
  local g=$1 out='' i c
  for ((i = 0; i < ${#g}; i++)); do
    c=${g:i:1}
    case "$c" in
    '*')
      if [ "${g:i+1:1}" = '*' ]; then
        out="${out}.*"
        i=$((i + 1))
      else
        out="${out}[^/]*"
      fi
      ;;
    '?') out="${out}[^/]" ;;
    '.' | '+' | '^' | '$' | '(' | ')' | '{' | '}' | '|' | '[' | ']')
      out="${out}\\$c"
      ;;
    [\\]) out="${out}\\\\" ;;
    *) out="${out}$c" ;;
    esac
  done
  printf '^%s$' "$out"
}

# Managed-policy parser: one "rule<TAB><regex>" line per rule (catch-all has
# an empty regex) followed by one "key<TAB><key>" line per recipient.
policy_rules() { # <file>
  awk -v q="'" '
    $0 ~ ("^  - path_regex:[[:space:]]*" q) {
      re = $0
      sub("^  - path_regex:[[:space:]]*" q, "", re)
      sub(q ".*$", "", re)
      print "rule\t" re
      next
    }
    /^  - key_groups:/ { print "rule\t"; next }
    $0 ~ ("^[[:space:]]+- " q "(ssh-(ed25519|rsa) |age1)") {
      k = $0
      sub("^[[:space:]]+- " q, "", k)
      sub(q ".*$", "", k)
      print "key\t" k
    }
  ' "$1"
}

# Load the managed policy into parallel arrays for per-path lookups:
# RULE_REGEXES[i] ('' = catch-all) and RULE_KEYS[i] (newline-joined, sorted
# like envelope_keys so the two compare directly).
RULE_REGEXES=()
RULE_KEYS=()
load_policy_rules() { # <file>
  RULE_REGEXES=()
  RULE_KEYS=()
  local tag rest i=-1
  while IFS=$'\t' read -r tag rest; do
    if [ "$tag" = 'rule' ]; then
      i=$((i + 1))
      RULE_REGEXES[i]=$rest
      RULE_KEYS[i]=''
    elif [ "$tag" = 'key' ] && [ "$i" -ge 0 ]; then
      RULE_KEYS[i]="${RULE_KEYS[i]}${RULE_KEYS[i]:+$'\n'}$rest"
    fi
  done < <(policy_rules "$1")
  [ "$i" -ge 0 ] || return 0
  for i in "${!RULE_KEYS[@]}"; do
    if [ -n "${RULE_KEYS[i]}" ]; then
      RULE_KEYS[i]=$(printf '%s\n' "${RULE_KEYS[i]}" | sort -u)
    fi
  done
}

# The recipient set a path's envelope must be wrapped to: first matching rule
# wins, replicating sops' own selection. Empty when no rule matches.
expected_keys() { # <path>
  [ ${#RULE_REGEXES[@]} -gt 0 ] || return 0
  local i
  for i in "${!RULE_REGEXES[@]}"; do
    if [ -z "${RULE_REGEXES[i]}" ] || [[ $1 =~ ${RULE_REGEXES[i]} ]]; then
      printf '%s' "${RULE_KEYS[i]}"
      return 0
    fi
  done
}

# Globs of the scoped rules, in rule order.
list_rule_globs() { # <file>
  awk '/^  - path_regex:/ && match($0, /# glob: /) { print substr($0, RSTART + 8) }' "$1"
}

# Recipient lines of the catch-all rule, verbatim (indentation and comments).
catchall_key_lines() { # <file>
  awk -v q="'" '
    /^  - path_regex:/ { incatch = 0 }
    /^  - key_groups:/ { incatch = 1; next }
    incatch && $0 ~ ("^[[:space:]]+- " q "(ssh-(ed25519|rsa) |age1)") { print }
  ' "$1"
}

# True when <glob>'s rule (the catch-all for '') already lists <key>.
rule_has_key() { # <file> <glob> <key>
  awk -v q="'" -v glob="$2" -v key="$3" '
    /^  - path_regex:/ {
      cur = ""
      if (match($0, /# glob: /)) cur = substr($0, RSTART + 8)
      target = (cur == glob)
      next
    }
    /^  - key_groups:/ { target = (glob == ""); next }
    target && index($0, q key q) { found = 1; exit }
    END { exit !found }
  ' "$1"
}

# Key tokens an envelope is actually wrapped to. Restricted to lines that
# mention "recipient" so base64 payload can't false-match.
envelope_keys() { # <file>
  LC_ALL=C grep -a 'recipient' "$1" |
    LC_ALL=C grep -aoE 'ssh-(ed25519|rsa) [A-Za-z0-9+/=]+|age1[0-9a-z]+' | sort -u || true
}

create_sops_yaml() { # <file>
  cat >"$1" <<'EOF'
# managed by glassine — edit recipients via `glassine allow` / `glassine revoke`
creation_rules:
  - key_groups:
      - age:
EOF
}

# Append one recipient under <glob>'s rule (the catch-all for ''). Returns 1
# on duplicate within that rule.
add_recipient() { # <file> <key> <comment> <glob>
  local file=$1 key=$2 comment=$3 glob=$4 tmp
  if rule_has_key "$file" "$glob" "$key"; then
    warn "already a recipient${glob:+ of $glob}: ${comment:-$key}"
    return 1
  fi
  ensure_tmpdir
  tmp="$GLASSINE_TMPDIR/sops_yaml"
  awk -v line="          - '${key}'${comment:+ # ${comment}}" -v glob="$glob" '
    /^  - path_regex:/ {
      cur = ""
      if (match($0, /# glob: /)) cur = substr($0, RSTART + 8)
      target = (cur == glob)
    }
    /^  - key_groups:/ { target = (glob == "") }
    { print }
    target && !done && $0 ~ /- age:[[:space:]]*$/ { print line; done = 1 }
  ' "$file" >"$tmp"
  cat "$tmp" >"$file"
}

# Ensure a scoped rule for <glob> exists, seeded with the catch-all's
# recipients so a scoped grant only ever widens access. New rules land after
# existing scoped rules and before the catch-all: sops takes the first
# matching rule, so on overlap the oldest rule wins.
ensure_path_rule() { # <file> <glob>
  local file=$1 glob=$2
  grep -qF "# glob: ${glob}" "$file" && return 0
  ensure_tmpdir
  local tmp="$GLASSINE_TMPDIR/sops_yaml" block="$GLASSINE_TMPDIR/rule_block"
  {
    printf "  - path_regex: '%s' # glob: %s\n" "$(glob_to_regex "$glob")" "$glob"
    printf '    key_groups:\n'
    printf '      - age:\n'
    catchall_key_lines "$file"
  } >"$block"
  awk -v blockfile="$block" '
    !inserted && /^  - key_groups:/ {
      while ((getline l < blockfile) > 0) print l
      close(blockfile)
      inserted = 1
    }
    { print }
  ' "$file" >"$tmp"
  cat "$tmp" >"$file"
  printf 'glassine: new scoped rule for %s (seeded with the repo-wide recipients)\n' "$glob"
}

# Resolve one allow argument into "key<TAB>comment" lines on stdout.
# Accepts a literal key, a path to a .pub file, or github:<user>.
resolve_recipients() { # <arg>
  local arg=$1 t b _rest user found=0
  case "$arg" in
  github:*)
    user=${arg#github:}
    command -v curl >/dev/null 2>&1 || die 'curl is required for github:<user> recipients'
    while read -r t b _rest; do
      case "$t" in
      ssh-ed25519 | ssh-rsa)
        printf '%s %s\tgithub:%s\n' "$t" "$b" "$user"
        found=1
        ;;
      esac
    done < <(curl -fsSL "https://github.com/${user}.keys" 2>/dev/null || true)
    [ "$found" -eq 1 ] || die "no usable SSH keys at github.com/${user}.keys"
    ;;
  ssh-ed25519\ * | ssh-rsa\ *)
    read -r t b _rest <<<"$arg"
    printf '%s %s\t%s\n' "$t" "$b" "${_rest:-}"
    ;;
  age1*)
    printf '%s\t\n' "$arg"
    ;;
  *)
    [ -f "$arg" ] || die "not a key, key file, or github:<user>: $arg"
    read -r t b _rest <"$arg"
    case "$t" in
    ssh-ed25519 | ssh-rsa) printf '%s %s\t%s\n' "$t" "$b" "${_rest:-$arg}" ;;
    *) die "unsupported key type '$t' in $arg (age accepts ssh-ed25519 and ssh-rsa)" ;;
    esac
    ;;
  esac
}

# Re-encrypt staged managed files if there are any (used after ACL changes).
rotate_if_managed() {
  local f
  while IFS= read -r -d '' f; do
    cmd_rotate
    return
  done < <(managed_files)
}

# Re-encrypt only the managed files a scoped rule covers. Warns (and skips)
# when the glob covers nothing — the classic sign of a typo or a path that
# was never `glassine protect`ed.
rotate_glob() { # <glob>
  local glob=$1 regex f files=()
  regex=$(glob_to_regex "$glob")
  while IFS= read -r -d '' f; do
    if [[ $f =~ $regex ]]; then
      files+=("$f")
    fi
  done < <(managed_files)
  if [ ${#files[@]} -eq 0 ]; then
    warn "$glob matches no glassine-managed files — is it protected in .gitattributes?"
    return 0
  fi
  cmd_rotate "${files[@]}"
}

cmd_allow() { # [--path <glob>] <key | path/to/key.pub | github:user>...
  local path_glob=''
  while [ $# -gt 0 ]; do
    case "$1" in
    --path)
      [ $# -ge 2 ] || die 'allow: --path requires a glob argument'
      path_glob=$2
      shift 2
      ;;
    *) break ;;
    esac
  done
  [ $# -gt 0 ] || die 'usage: glassine allow [--path <glob>] <ssh-pubkey | key-file.pub | github:user>...'
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  need_sops
  ensure_tmpdir

  local recips="$GLASSINE_TMPDIR/recips" arg
  : >"$recips"
  for arg in "$@"; do
    resolve_recipients "$arg" >>"$recips"
  done
  [ -s "$recips" ] || die 'no recipients resolved'

  local sops_yaml="$root/.sops.yaml"
  if [ ! -f "$sops_yaml" ]; then
    [ -z "$path_glob" ] ||
      die "no .sops.yaml yet — run 'glassine init' (or a plain 'glassine allow') before scoping recipients"
    create_sops_yaml "$sops_yaml"
  elif ! sops_yaml_managed "$sops_yaml"; then
    die '.sops.yaml is not managed by glassine — add recipients there manually'
  fi

  [ -z "$path_glob" ] || ensure_path_rule "$sops_yaml" "$path_glob"

  local key comment glob added=0
  while IFS=$'\t' read -r key comment; do
    if [ -n "$path_glob" ]; then
      if add_recipient "$sops_yaml" "$key" "$comment" "$path_glob"; then
        printf 'glassine: allowed %s for %s\n' "${comment:-$key}" "$path_glob"
        added=$((added + 1))
      fi
    else
      if add_recipient "$sops_yaml" "$key" "$comment" ''; then
        printf 'glassine: allowed %s\n' "${comment:-$key}"
        added=$((added + 1))
        # Scoped rules stay a superset of the repo-wide set: a global grant
        # reaches every scoped rule too (duplicates are silently fine).
        while IFS= read -r glob; do
          add_recipient "$sops_yaml" "$key" "$comment" "$glob" 2>/dev/null || true
        done < <(list_rule_globs "$sops_yaml")
      fi
    fi
  done <"$recips"

  if [ "$added" -gt 0 ]; then
    if [ -n "$path_glob" ]; then
      rotate_glob "$path_glob"
    else
      rotate_if_managed
    fi
  fi
}

cmd_revoke() { # [--path <glob>] <pattern>
  local path_glob=''
  while [ $# -gt 0 ]; do
    case "$1" in
    --path)
      [ $# -ge 2 ] || die 'revoke: --path requires a glob argument'
      path_glob=$2
      shift 2
      ;;
    *) break ;;
    esac
  done
  [ $# -eq 1 ] || die 'usage: glassine revoke [--path <glob>] <pattern matching a recipient line>'
  local pattern=$1 root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  need_sops
  local sops_yaml="$root/.sops.yaml"
  [ -f "$sops_yaml" ] || die 'no .sops.yaml in this repository'
  sops_yaml_managed "$sops_yaml" || die '.sops.yaml is not managed by glassine — remove recipients there manually'
  if [ -n "$path_glob" ] && ! grep -qF "# glob: ${path_glob}" "$sops_yaml"; then
    die "no scoped rule for: $path_glob"
  fi

  ensure_tmpdir
  local tmp="$GLASSINE_TMPDIR/sops_yaml" counts="$GLASSINE_TMPDIR/revoke_count" rc=0
  # Delete matching recipient lines in the targeted rule(s), but never leave
  # any rule without recipients — sops would refuse to encrypt its files.
  awk -v q="'" -v pat="$pattern" -v glob="$path_glob" -v cf="$counts" '
    /^  - path_regex:/ {
      cur = ""
      if (match($0, /# glob: /)) cur = substr($0, RSTART + 8)
      rule++
      target = (glob == "" || cur == glob)
    }
    /^  - key_groups:/ { rule++; target = (glob == "") }
    $0 ~ ("^[[:space:]]+- " q "(ssh-(ed25519|rsa) |age1)") {
      if (target && $0 ~ pat) { removed++; next }
      kept[rule]++
    }
    { print }
    END {
      printf "%d\n", removed > cf
      if (removed == 0) exit 2
      for (r = 1; r <= rule; r++) if (!kept[r]) exit 3
    }
  ' "$sops_yaml" >"$tmp" || rc=$?
  case "$rc" in
  0) ;;
  2) die "no recipient matches${path_glob:+ in $path_glob}: $pattern" ;;
  3) die "refusing to leave a rule with no recipients ($pattern matches too much)" ;;
  *) die "revoke failed (awk exit $rc)" ;;
  esac
  cat "$tmp" >"$sops_yaml"
  printf 'glassine: revoked %d recipient(s) matching %s%s\n' \
    "$(cat "$counts")" "$pattern" "${path_glob:+ from $path_glob}"

  if [ -n "$path_glob" ]; then
    rotate_glob "$path_glob"
  else
    rotate_if_managed
  fi
  warn 'revocation is forward-only: the revoked key keeps history it could already read — rotate the secret values too if this was a compromise'
}

cmd_protect() { # <glob>...
  [ $# -gt 0 ] || die "usage: glassine protect <glob>...  (e.g. glassine protect 'secrets/**')"
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  need_sops

  local attrs="$root/.gitattributes" g line
  for g in "$@"; do
    line="$g filter=glassine diff=glassine merge=glassine"
    if [ -f "$attrs" ] && grep -qxF "$line" "$attrs"; then
      warn "already protected: $g"
      continue
    fi
    printf '%s\n' "$line" >>"$attrs"
    printf 'glassine: protecting %s\n' "$g"
  done

  # Encrypt any already-tracked plaintext now covered by the new globs.
  ensure_tmpdir
  local f blob="$GLASSINE_TMPDIR/blob" reencrypted=0
  while IFS= read -r -d '' f; do
    if git cat-file blob ":$f" >"$blob" 2>/dev/null && ! is_envelope "$blob"; then
      if is_binary "$root/$f"; then
        warn "protecting a binary file: $f — glassine encrypts it fine, but it won't diff (opaque base64 blob); exclude it if you want reviewable history"
      fi
      git add --renormalize -- "$f"
      reencrypted=$((reencrypted + 1))
    fi
  done < <(managed_files)
  if [ "$reencrypted" -gt 0 ]; then
    printf 'glassine: re-staged %d previously-plaintext file(s) encrypted — review and commit\n' "$reencrypted"
    warn 'their plaintext remains in earlier commits; rotate those secret values if sensitive'
  fi
}

cmd_init() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  need_sops
  command -v glassine >/dev/null 2>&1 ||
    warn 'glassine is not on PATH; the filters below will fail until it is'

  git config filter.glassine.clean 'glassine clean %f'
  git config filter.glassine.smudge 'glassine smudge %f'
  # A failing clean must abort the operation; without this git would silently
  # stage plaintext when the filter errors.
  git config filter.glassine.required true
  git config diff.glassine.textconv 'glassine textconv'
  git config merge.glassine.name 'glassine three-way merge of sops envelopes'
  git config merge.glassine.driver 'glassine merge %O %A %B %L %P'

  if [ ! -f "$root/.sops.yaml" ]; then
    local pub='' candidate t b _rest
    for candidate in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub"; do
      if [ -f "$candidate" ]; then
        pub=$candidate
        break
      fi
    done
    if [ -n "$pub" ]; then
      create_sops_yaml "$root/.sops.yaml"
      read -r t b _rest <"$pub"
      add_recipient "$root/.sops.yaml" "$t $b" "${_rest:-$(hostname)}" '' || true
      printf "glassine: created .sops.yaml with this host's key (%s)\n" "$pub"
      printf 'glassine: add more recipients with: glassine allow <key | key.pub | github:user>\n'
    else
      warn 'no .sops.yaml and no ~/.ssh key found — bootstrap recipients with: glassine allow <key>'
    fi
  fi

  if ! has_identity; then
    warn 'no decryption identity found — no SSH key pairs in ~/.ssh, no glassine.identity config, no sops env vars; envelopes will pass through as ciphertext'
  fi

  # Refresh worktree copies that are still ciphertext (e.g. right after
  # cloning, before the filter existed). Note: checkout-index bypasses smudge
  # filters, so delete + checkout is the reliable re-smudge idiom.
  ensure_tmpdir
  local f refreshed=0 opaque=''
  while IFS= read -r -d '' f; do
    if [ -f "$root/$f" ] && is_envelope "$root/$f"; then
      rm -f -- "$root/$f"
      git checkout -- "$f"
      # The smudge filter passes ciphertext through when no identity matches
      # the envelope's recipients, so re-check before claiming success.
      if is_envelope "$root/$f"; then
        opaque="$opaque $f"
      else
        refreshed=$((refreshed + 1))
      fi
    fi
  done < <(managed_files)
  [ "$refreshed" -eq 0 ] || printf 'glassine: decrypted %d file(s) into the working tree\n' "$refreshed"
  [ -z "$opaque" ] || warn "still ciphertext (no identity on this host matches their recipients):$opaque"

  printf 'glassine: filters configured for %s\n' "$root"
  printf "glassine: choose what to protect, e.g.: glassine protect 'secrets/**'\n"
}

cmd_uninstall() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die 'not inside a git repository'
  git config --remove-section filter.glassine 2>/dev/null || true
  git config --remove-section diff.glassine 2>/dev/null || true
  warn 'filters removed; working-tree plaintext is untouched but future checkouts produce ciphertext'
}

# Force re-encryption with fresh data keys under the current .sops.yaml.
# Run after changing recipients: removing a recipient without rotating only
# stops them reading *future* envelopes once content changes — this command
# makes the cut immediate and mints new data keys (sops rotate semantics).
#
# Re-minting needs the plaintext, so a worktree copy that is still ciphertext
# only rotates where a local key can decrypt it. Files left behind are
# reported, never silently skipped: recipient drift is fatal, a blob the
# filter never encrypted at all (rotate before init) is fatal; an envelope
# that already matches policy but keeps its old data key is a warning.
cmd_rotate() { # [pathspec...]
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  # Explicit pathspecs go through managed_files too, so the symlink/submodule
  # exemption and the filter=glassine boundary hold no matter how a file is
  # named; anything else fails here with an exact reason instead of surfacing
  # later as a bogus rotation report.
  local files=() f
  while IFS= read -r -d '' f; do files+=("$f"); done < <(managed_files "$@")
  if [ ${#files[@]} -eq 0 ]; then
    [ $# -eq 0 ] || die "no glassine-managed regular files match: $*"
    die 'no glassine-managed files found (set "filter=glassine" in .gitattributes)'
  fi

  local old_hashes=()
  for f in "${files[@]}"; do
    old_hashes+=("$(git ls-files -s -- "$f" | awk '{print $2}')")
  done

  GLASSINE_FORCE=1 git add --renormalize -- "${files[@]}"

  local policy='' policy_loaded=0
  if [ -f "$root/.sops.yaml" ] && sops_yaml_managed "$root/.sops.yaml"; then
    policy_loaded=1
    load_policy_rules "$root/.sops.yaml"
  fi

  ensure_tmpdir
  local blob="$GLASSINE_TMPDIR/rotate_blob" i new rotated=0 stale='' drifted='' unfiltered=''
  for i in "${!files[@]}"; do
    f=${files[$i]}
    new=$(git ls-files -s -- "$f" | awk '{print $2}')
    [ -n "$new" ] || continue
    if [ "$new" != "${old_hashes[$i]}" ]; then
      rotated=$((rotated + 1))
      # A fresh envelope over a still-ciphertext worktree copy would dirty the
      # file forever; refresh the worktree through smudge (init's idiom).
      if [ -f "$f" ] && is_envelope "$f"; then
        rm -f -- "$f"
        git checkout -- "$f"
      fi
      continue
    fi
    git cat-file blob "$new" >"$blob" 2>/dev/null || continue
    [ -s "$blob" ] || continue # empty files pass through unencrypted by design
    policy=''
    [ "$policy_loaded" = 0 ] || policy=$(expected_keys "$f")
    if ! is_envelope "$blob"; then
      unfiltered="$unfiltered $f"
    elif [ -n "$policy" ] && [ "$(envelope_keys "$blob")" != "$policy" ]; then
      drifted="$drifted $f"
    else
      stale="$stale $f"
    fi
  done

  [ "$rotated" -eq 0 ] ||
    printf 'glassine: re-encrypted %d file(s) with fresh data keys — review and commit\n' "$rotated"
  [ -z "$stale" ] ||
    warn "data keys NOT refreshed for:$stale — worktree copies are ciphertext this host cannot decrypt"
  [ -z "$unfiltered" ] ||
    warn "cannot re-encrypt:$unfiltered — the glassine filter never encrypted these; run \"glassine init\", then rotate again"
  [ -z "$drifted" ] ||
    warn "cannot re-encrypt:$drifted — recipients changed but no local key can decrypt the old envelope; run rotate on a host holding a previous recipient key"
  [ -z "$unfiltered$drifted" ] || exit 1
}

# Verify every staged managed file is an envelope, and (for a glassine-managed
# .sops.yaml) that each envelope's recipient set matches policy. Run as a
# pre-commit hook. Catches two failure classes:
#  - the filter silently not running (.gitattributes set, git config missing)
#  - recipient drift: merging a branch that changed .sops.yaml re-encrypts
#    envelopes under the pre-merge policy, so newly-allowed keys silently
#    can't read (and newly-revoked ones still can) until a rotate
cmd_check() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a git repository'
  ensure_tmpdir
  local f bad=0 drift=0 blob="$GLASSINE_TMPDIR/blob" policy='' policy_loaded=0
  if [ -f "$root/.sops.yaml" ] && sops_yaml_managed "$root/.sops.yaml"; then
    policy_loaded=1
    load_policy_rules "$root/.sops.yaml"
  fi
  while IFS= read -r -d '' f; do
    # Empty blobs pass through unencrypted by design — nothing to protect.
    if ! git cat-file blob ":$f" >"$blob" 2>/dev/null || [ ! -s "$blob" ]; then
      continue
    fi
    policy=''
    [ "$policy_loaded" = 0 ] || policy=$(expected_keys "$f")
    if ! is_envelope "$blob"; then
      printf 'glassine: NOT ENCRYPTED in index: %s\n' "$f" >&2
      bad=1
    elif [ -n "$policy" ] && [ "$(envelope_keys "$blob")" != "$policy" ]; then
      printf 'glassine: RECIPIENT DRIFT in index: %s\n' "$f" >&2
      drift=1
    fi
    # Advisory (non-fatal): an encrypted binary round-trips but can't diff and
    # is a frequent encryption footgun. Judge the worktree plaintext; on a
    # keyless host it's still an envelope, so there's nothing to advise on.
    if [ -f "$root/$f" ] && ! is_envelope "$root/$f" && is_binary "$root/$f"; then
      printf 'glassine: BINARY under glassine: %s — stored as an opaque base64 blob (no diff); consider excluding it from filter=glassine\n' "$f" >&2
    fi
  done < <(managed_files)
  [ "$bad" -eq 0 ] || die 'plaintext staged for managed paths — run "glassine init" then "glassine rotate"'
  [ "$drift" -eq 0 ] || die 'envelopes do not match .sops.yaml recipients (common after merges) — run "glassine rotate" and commit'
}

cmd_status() {
  ensure_tmpdir
  local f state blob="$GLASSINE_TMPDIR/blob"
  while IFS= read -r -d '' f; do
    state='not-staged'
    if git cat-file blob ":$f" >"$blob" 2>/dev/null; then
      if is_envelope "$blob"; then
        state='encrypted'
      elif [ ! -s "$blob" ]; then
        state='empty'
      else
        state='PLAINTEXT'
      fi
    fi
    printf '%-11s %s\n' "$state" "$f"
  done < <(managed_files)
}

usage() {
  cat <<'EOF'
glassine — transparent sops-backed encryption for git

USAGE
  glassine <command> [args]

COMMANDS
  init           configure this repository (idempotent): filters + merge
                 driver; bootstraps .sops.yaml with this host's SSH key;
                 decrypts still-encrypted worktree files (e.g. after cloning)
  protect <g>…   protect globs: writes .gitattributes lines and encrypts any
                 already-tracked plaintext matches
  allow [--path <glob>] <r>…
                 add recipients: a literal key, a .pub file, or github:user
                 (fetches github.com/<user>.keys); re-encrypts managed files.
                 --path scopes them to files matching <glob>: the scoped rule
                 is seeded with the repo-wide recipients, so it only ever
                 widens access, and only its own files rotate
  revoke [--path <glob>] <pat>
                 remove recipients matching <pat> and rotate data keys
                 (forward-only: rotate secret values too on compromise);
                 --path removes them from that scoped rule only
  status         list managed files and their index state
  check          fail if any staged managed file is unencrypted (pre-commit);
                 also advises (non-fatally) on binary content under glassine
  rotate [f…]    force re-encryption with fresh data keys under .sops.yaml;
                 re-mints still-ciphertext worktree copies where a key allows,
                 and reports the files it cannot re-encrypt
  uninstall      remove the filter configuration from this repository
  version        print version

CONFIG
  git config glassine.identity <path>
                 SSH private key used for decryption. Normally set for you:
                 when sops' default probe paths (~/.ssh/id_ed25519,
                 ~/.ssh/id_rsa) fail, glassine scans ~/.ssh for the key pair
                 matching the envelope's recipients and pins the winner here.
                 An explicit SOPS_AGE_SSH_PRIVATE_KEY_FILE wins.

INTERNAL (invoked by git)
  clean / smudge / textconv / merge

QUICKSTART (per repository)
  glassine init
  glassine protect 'secrets/**'
  glassine allow github:teammate     # optional
EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  maybe_export_identity
  case "$cmd" in
  clean) cmd_clean "$@" ;;
  smudge) cmd_smudge "$@" ;;
  textconv) cmd_textconv "$@" ;;
  merge) cmd_merge "$@" ;;
  init) cmd_init "$@" ;;
  protect) cmd_protect "$@" ;;
  allow) cmd_allow "$@" ;;
  revoke) cmd_revoke "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  rotate) cmd_rotate "$@" ;;
  check) cmd_check "$@" ;;
  status) cmd_status "$@" ;;
  version | --version | -v) printf 'glassine %s\n' "$VERSION" ;;
  help | --help | -h) usage ;;
  *) die "unknown command: $cmd (try: glassine help)" ;;
  esac
}

main "$@"
